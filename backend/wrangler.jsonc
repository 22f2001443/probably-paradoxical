/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "probably-paradoxical",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-31",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	/**
	 * Cron trigger: runs the scheduled() handler every minute to apply due
	 * scheduled stage transitions. https://developers.cloudflare.com/workers/configuration/cron-triggers/
	 */
	"triggers": {
		"crons": ["* * * * *"]
	},
	/**
	 * Rate Limiting binding for auth endpoints (per-IP).
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
	 * `period` must be 10 or 60. The Worker falls back to an in-memory limiter
	 * if this binding is not present.
	 */
	"unsafe": {
		"bindings": [
			{
				"name": "AUTH_RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1001",
				"simple": { "limit": 10, "period": 60 }
			}
		]
	},
	/**
	 * R2 bucket for participant file uploads (questionnaire PDFs, datasets, etc.).
	 * Create it before deploying: `wrangler r2 bucket create probably-paradoxical-submissions`.
	 * Local dev uses an automatic on-disk simulation, so no setup is needed.
	 * https://developers.cloudflare.com/r2/buckets/
	 */
	"r2_buckets": [
		{
			"binding": "SUBMISSIONS_BUCKET",
			"bucket_name": "probably-paradoxical-submissions"
		}
	]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
