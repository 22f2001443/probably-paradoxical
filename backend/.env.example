# Copy this file to .env and fill in your local values.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGODB_DB=probably_paradoxical

# Secret required by POST /setup/database
SETUP_SECRET=change-this-local-setup-secret

# JWT settings for login tokens
JWT_SECRET=change-this-to-a-random-string-with-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=28800

# Optional initial admin seeded by npm run db:setup
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
ADMIN_PASSWORD=change-this-admin-password

# Optional team password seeding.
# Use TEAM_PASSWORDS_JSON for per-team passwords, or DEFAULT_TEAM_PASSWORD for every team.
TEAM_PASSWORDS_JSON={"T01":"change-this-team-password"}
# DEFAULT_TEAM_PASSWORD=

# Backend server settings
PORT=5000
NODE_ENV=development
